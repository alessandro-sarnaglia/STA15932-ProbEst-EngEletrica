# Gerando o domínio para a curva normal padrão
x <- seq(-3.5, 3.5, length = 500)
y <- dnorm(x)
# 2. Desenhando o gráfico base (rejeição à esquerda)
plot(
x, y,
type = "l",
lwd = 2.5,
col = "black",
axes = FALSE,
xlab = "z",
ylab = "",
main = expression(paste("Região de Rejeição à Esquerda"))
)
# Customização do eixo x incluindo o ponto crítico negativo
axis(1, at = c(-3, -2, z_critico, -1, 0, 1, -z_critico, 2, 3),
labels = c("-3", "-2", expression(-z[alpha/2]), "-1", "0", "1", expression(z[alpha/2]), "2", "3"), cex.axis = 1)
axis(1, at = c(z_critico),
labels = c(expression(-z[alpha/2])), cex.axis = 1, col = "red")
# 3. Colorindo a região de rejeição (cauda inferior/esquerda)
x_shading <- seq(-3.5, z_critico, length = 100)
y_shading <- dnorm(x_shading)
polygon(c(-3.5, x_shading, z_critico), c(0, y_shading, 0), col = rgb(0.23, 0.35, 0.60, 0.4), border = NA)
x_shading <- seq(-z_critico, 3.5, length = 100)
y_shading <- dnorm(x_shading)
polygon(c(-z_critico, x_shading, 3.5), c(0, y_shading, 0), col = rgb(0.23, 0.35, 0.60, 0.4), border = NA)
# Linha vertical indicativa do z crítico
abline(v = z_critico, lty = 2, col = "#3b5998", lwd = 1.5)
abline(v = -z_critico, lty = 2, col = "#3b5998", lwd = 1.5)
# 4. Adicionando rótulo para a área alpha
text(x = z_critico - 0.3, y = 0.03, labels = expression(alpha/2), col = "#3b5998", font = 2, cex = .8)
text(x = -z_critico + 0.3, y = 0.03, labels = expression(alpha/2), col = "#3b5998", font = 2, cex = .8)
# Linha de base horizontal
abline(h = 0, col = "gray50")
