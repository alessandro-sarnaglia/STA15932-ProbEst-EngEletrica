R <- 1000; n <- 9; lambda <- .5
cob1 <- cob2 <- NULL
### Gera a amostra de uma Exp(lambda)
x <- rexp(n = n, rate = lambda)
x
### Calcula os intervalos
lamb_hat <- 1/mean(x)
lamb_hat
L1 <- lamb_hat*(1-1.96/sqrt(n))
U1 <- lamb_hat*(1+1.96/sqrt(n))
L2 <- qgamma(p = (1-.95)/2, shape = n, rate = 1)*lamb_hat/n
U2 <- qgamma(p = (1+.95)/2, shape = n, rate = 1)*lamb_hat/n
c(L1, U1)
c(L2, U2)
R <- 1000; n <- 9; lambda <- .5
cob1 <- cob2 <- NULL
for (r in 1:R) {
### Gera a amostra de uma Exp(lambda)
x <- rexp(n = n, rate = lambda)
### Calcula os intervalos
lamb_hat <- 1/mean(x)
L1 <- lamb_hat*(1-1.96/sqrt(n))
U1 <- lamb_hat*(1+1.96/sqrt(n))
L2 <- qgamma(p = (1-.95)/2, shape = n, rate = 1)*lamb_hat/n
U2 <- qgamma(p = (1+.95)/2, shape = n, rate = 1)*lamb_hat/n
# c(L1, U1)
# c(L2, U2)
### Armazena em um vetor
cob1[r] <- as.numeric(lambda > L1 & lambda < U1)
cob2[r] <- as.numeric(lambda > L2 & lambda < U2)
}
#### Medidas empíricas
mean(cob1)
mean(cob2)
