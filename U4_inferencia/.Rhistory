R <- 10000; n <- 500; lambda <- .5; alph <- 0.9
ampl1 <- ampl2 <- cob1 <- cob2 <- NULL
for (r in 1:R) {
### Gera a amostra de uma Exp(lambda)
x <- rexp(n = n, rate = lambda)
### Calcula os intervalos
lamb_hat <- 1/mean(x)
L1 <- lamb_hat*(1-qnorm((1+alph)/2)/sqrt(n))
U1 <- lamb_hat*(1+qnorm((1+alph)/2)/sqrt(n))
L2 <- qgamma(p = (1-alph)/2, shape = n, rate = 1)*lamb_hat/n
U2 <- qgamma(p = (1+alph)/2, shape = n, rate = 1)*lamb_hat/n
# c(L1, U1)
# c(L2, U2)
### Armazena em um vetor
cob1[r] <- as.numeric(lambda > L1 & lambda < U1)
cob2[r] <- as.numeric(lambda > L2 & lambda < U2)
ampl1[r] <- U1 - L1
ampl2[r] <- U2 - L2
}
#### Medidas empíricas
mean(cob1)
mean(cob2)
mean(ampl1)
mean(ampl2)
#| fig-align: center
#| fig-width: 7
#| fig-height: 4
#| echo: false
# 1. Configurando os parâmetros da distribuição
alpha <- 0.1
z_critico <- qnorm(alpha) # Calcula o ponto crítico (-1.28)
# Gerando o domínio para a curva normal padrão
x <- seq(-3.5, 3.5, length = 500)
y <- dnorm(x)
# 2. Desenhando o gráfico base
plot(
x, y,
type = "l",
lwd = 2.5,
col = "black",
axes = FALSE,
xlab = "z",
ylab = "",
main = expression(paste("Região de Rejeição (Área ", alpha, " = 0.10 à Esquerda)"))
)
# Customização do eixo x incluindo o ponto z_critico
axis(1, at = c(-3, -2, z_critico, 0, 1, 2, 3),
labels = c("-3", "-2", "-1.28", "0", "1", "2", "3"), cex.axis = 1.1)
# 3. Colorindo a região de rejeição (cauda esquerda)
x_shading <- seq(-3.5, z_critico, length = 100)
y_shading <- dnorm(x_shading)
polygon(c(-3.5, x_shading, z_critico), c(0, y_shading, 0), col = rgb(0.23, 0.35, 0.60, 0.4), border = NA)
# Linha vertical indicativa do z crítico
abline(v = z_critico, lty = 2, col = "#3b5998", lwd = 1.5)
# 4. Adicionando rótulo para a área alpha
text(x = -2.1, y = 0.05, labels = expression(alpha == 0.10), col = "#3b5998", font = 2, cex = 1.2)
# Linha de base horizontal
abline(h = 0, col = "gray50")
