R <- 10000; n <- 10; lambda <- .5; alph <- 0.9
ampl1 <- ampl2 <- cob1 <- cob2 <- NULL
for (r in 1:R) {
### Gera a amostra de uma Exp(lambda)
x <- rexp(n = n, rate = lambda)
### Calcula os intervalos
lamb_hat <- 1/mean(x)
L1 <- lamb_hat*(1-qnorm((1+alph)/2)/sqrt(n))
U1 <- lamb_hat*(1+qnorm((1+alph)/2)/sqrt(n))
L2 <- qgamma(p = (1-alph)/2, shape = n, rate = 1)*lamb_hat/n
U2 <- qgamma(p = (1+alph)/2, shape = n, rate = 1)*lamb_hat/n
# c(L1, U1)
# c(L2, U2)
### Armazena em um vetor
cob1[r] <- as.numeric(lambda > L1 & lambda < U1)
cob2[r] <- as.numeric(lambda > L2 & lambda < U2)
ampl1[r] <- U1 - L1
ampl2[r] <- U2 - L2
}
#### Medidas empíricas
mean(cob1)
mean(cob2)
mean(ampl1)
mean(ampl2)
