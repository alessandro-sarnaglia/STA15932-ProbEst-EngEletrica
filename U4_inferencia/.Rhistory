x, y,
type = "l",
lwd = 2.5,
col = "black",
axes = FALSE,
xlab = "z",
ylab = "",
main = ""
)
# Customização do eixo x incluindo o ponto z_alpha
axis(1, at = c(-3, -2, -1, 0, 1, 2, 3),
labels = c("-3", "-2", "-1", "0", "1", "2", "3"), cex.axis = 1.1)
axis(1, at = c(z_alpha),
labels = c(expression(z[alpha])), cex.axis = 1, col.axis = "#3b5998", col = "#3b5998", col.ticks = "#3b5998")
# 3. Colorindo a região de rejeição (cauda superior)
x_shading <- seq(z_alpha, 3.5, length = 100)
y_shading <- dnorm(x_shading)
polygon(c(z_alpha, x_shading, 3.5), c(0, y_shading, 0), col = rgb(0.23, 0.35, 0.60, 0.4), border = NA)
# Linha vertical indicativa do z crítico
abline(v = z_alpha, lty = 2, col = "#3b5998", lwd = 1.5)
# 4. Adicionando rótulo para a área alpha
text(x = z_alpha + 0.3, y = 0.03, labels = expression(alpha), col = "#3b5998", font = 2, cex = 1.2)
# Linha de base horizontal
abline(h = 0, col = "gray50")
