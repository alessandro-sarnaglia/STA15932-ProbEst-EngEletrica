pv_KS <- c(pv_KS, pv2)
names(pv_JB)[jj] <- names(pv_KS)[jj] <- fam_$family[1]
cat('p-value JB: ',pv1,'\n',
'p-value KS: ',pv2,'\n',sep='')
}
pv_JB_l[[ii]] <- pv_JB
pv_KS_l[[ii]] <- pv_KS
fitP_nn[[ii]] <- fitP_aux
ii <- ii+1
}
