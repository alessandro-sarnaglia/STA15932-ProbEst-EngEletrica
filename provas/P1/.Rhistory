pred_value <- function(fitP, newdataP, olddataP){
fam_ <- eval(call(name = fitP$family[1]))
if('mu' %in% names(fam_$parameters))
mu <- predict(fitP, what = 'mu', newdata = newdataP, type = 'response', data=olddataP)
if(any(mu)<=0) mu[which(mu<=0)] <- 0.000001
if('sigma' %in% names(fam_$parameters))
sig <- predict(fitP, what = 'sigma', newdata = newdataP, type = 'response', data=olddataP)
if('nu' %in% names(fam_$parameters))
nu <- predict(fitP, what = 'nu', newdata = newdataP, type = 'response', data=olddataP)
if('tau' %in% names(fam_$parameters))
tau <- predict(fitP, what = 'tau', newdata = newdataP, type = 'response', data=olddataP)
if(!('mu' %in% names(fam_$parameters))) stop(paste('There is no parameter in family: ',fam_$family[1], sep=''))
n <- length(mu)
if('sigma' %in% names(fam_$parameters)){
if('nu' %in% names(fam_$parameters)){
if('tau' %in% names(fam_$parameters)){
smpl <- eval(parse(text = paste('r',fitP$family[1],'(n=n, mu=mu, sigma=sig, nu=nu, tau=tau)',sep='')))
}else{
smpl <- eval(parse(text = paste('r',fitP$family[1],'(n=n, mu=mu, sigma=sig, nu=nu)',sep='')))
}
}else{
smpl <- eval(parse(text = paste('r',fitP$family[1],'(n=n, mu=mu, sigma=sig)',sep='')))
}
}else{
smpl <- eval(parse(text = paste('r',fitP$family[1],'(n=n, mu=mu)',sep='')))
}
return(smpl)
}
